{
  "name": "github-telemetry",
  "version": "0.1.0",
  "description": "Fetches repository metrics, commit velocity, and health indicators from GitHub for Tech Radar evaluation.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/stdio.js",
    "start:http": "node hosted/server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "verify:live": "node scripts/verify-live.js",
    "verify:stdio": "node scripts/verify-stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  }
}
